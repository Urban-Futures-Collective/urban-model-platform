#---- App settings ----
# UMP_API_SERVER_URL is the public base URL, used to build the self/results
# links returned in job responses. It should be the externally reachable base.
UMP_LOG_LEVEL=INFO
UMP_PROVIDERS_FILE=providers.yaml
UMP_API_SERVER_URL=http://localhost:8000/
UMP_API_SERVER_HOST=0.0.0.0
UMP_API_SERVER_PORT=8000
UMP_API_SERVER_WORKERS=1

# NOTE (v2 -> v3): this no longer mounts the API under a prefix. v3 serves its
# routes at /v1.0/... unconditionally; this value only decorates the links in
# responses. If a reverse proxy publishes UMP under /api, it must strip that
# prefix before proxying, or clients must be pointed at the new paths.
UMP_API_SERVER_URL_PREFIX=/

#---- Job store ----
# "memory" (default) keeps jobs in the process and is for local development
# only. Production must set "postgres".
UMP_JOB_STORE=postgres
UMP_DATABASE_NAME=ump
UMP_DATABASE_HOST=localhost
UMP_DATABASE_PORT=5432
UMP_DATABASE_USER=ump
UMP_DATABASE_PASSWORD=ump
# Alternatively a full async DSN, which takes precedence over the five vars above:
# UMP_DATABASE_URL=postgresql+asyncpg://ump:ump@localhost:5432/ump

#---- Remote job handling ----
UMP_REMOTE_JOB_STATUS_REQUEST_INTERVAL=5
# Seconds to wait for a remote job before marking it failed (unset = no timeout):
# UMP_REMOTE_JOB_TTW=1500
UMP_VERIFY_REMOTE_RESULTS=True
UMP_RESULTS_FETCH_TIMEOUT=30
# minutes:
UMP_JOB_DELETE_INTERVAL=240

#---- Authentication ----
# NOTE (v2 -> v3): the UMP_KEYCLOAK_* variables are gone. v3 validates JWTs
# offline against the IdP's JWKS endpoint and never calls Keycloak's admin API,
# so no admin user or password is needed.
UMP_AUTH_ENABLED=False
# Keycloak: https://<host>/auth/realms/<realm>/protocol/openid-connect/certs
UMP_JWKS_URL=
# Must match the token's 'iss' exactly, e.g. https://<host>/auth/realms/<realm>
UMP_JWT_ISSUER=
# Must match the token's 'aud' (leave empty to skip the audience check)
UMP_JWT_AUDIENCE=
# Comma-separated dot-paths to role arrays. For Keycloak client roles, add the
# resource_access path as well:
#   UMP_JWT_ROLES_CLAIMS=realm_access.roles,resource_access.ump-client.roles
UMP_JWT_ROLES_CLAIMS=realm_access.roles
UMP_JWKS_CACHE_TTL_SECONDS=3600
# When False, GET /processes requires a token. NOTE: with UMP_AUTH_ENABLED=False
# the caller counts as unauthenticated, so /processes answers 401 unless this is
# True — set both together when running without auth.
UMP_PUBLIC_PROCESSES=False

#---- CORS ----
# NOTE (v2 -> v3): v2 allowed all origins unconditionally. v3 emits no CORS
# headers unless this is set, which breaks browser frontends silently.
# JSON list syntax (pydantic-settings), NOT a bare comma-separated string:
#   UMP_CORS_ORIGINS=["https://frontend.example.org"]
UMP_CORS_ORIGINS=[]

#---- API versions ----
# JSON list syntax, as above. Route prefixes: /v1.0/... and /mcp/v1/tools
UMP_SUPPORTED_API_VERSIONS=["1.0"]
UMP_MCP_CATALOG_VERSIONS=["1"]

#---- example modelserver settings
PYGEOAPI_SERVER_HOST=localhost
PYGEOAPI_SERVER_PORT_INTERNAL=5000
PYGEOAPI_SERVER_PORT_EXTERNAL=5005

#---- docker dev environment settings ----
DOCKER_NETWORK=ump_dev
WEBAPP_PORT_EXTERNAL=5003
