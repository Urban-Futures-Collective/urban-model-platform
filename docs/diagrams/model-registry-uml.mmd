---
title: UMP Model Registry — schema "registry" (REF-F12) · L = language map {de, en, …}
config:
  class:
    hideEmptyMembersBox: true
---
classDiagram
direction LR

namespace Keycloak {
  class KeycloakRealm {
    <<external>>
    +user id = sub
    +platform roles : provider | verifier | user | viewer
    +platform roles : access-admin | platform-admin
    +model access roles : provider
    +model access roles : provider∶process
    +edited by UMP-X admin pages [REF-F11]
  }
}

namespace Registry {
  class app_user {
    <<table>>
    +sub : text PK  [JWT sub]
    +display_name : text
    +email : text
    +first_seen_at : timestamptz
    +last_seen_at : timestamptz
  }
  class provider_server {
    <<table>>
    +id : uuid PK
    +name : text UK  [process-id prefix]
    +base_url : text
    +owner_sub : text FK
    +auth_type : NoAuth | BasicAuth | ApiKey | BearerToken
    +credentials : bytea  [encrypted, write-only]
    +ttw_job_done_seconds : numeric
    +is_active : boolean
    +last_discovered_at : timestamptz
    +created_at : timestamptz
    +updated_at : timestamptz
  }
  class model {
    <<table>>
    +id : uuid PK
    +slug : text UK
    +provider_server_id : uuid FK
    +remote_process_id : text  UK[server, process]
    +owner_sub : text FK
    +default_lang : text  [e.g. de, required in every L]
    +full_name : jsonb  [L]
    +short_description : jsonb  [L]
    +purpose : jsonb  [L]
    +limitations_risks : jsonb  [L]
    +keywords : jsonb  [lang → list]
    +version_label : text
    +repository_url : text
    +code_ref : text
    +license : text  [SPDX]
    +requirements : jsonb
    +contributors : jsonb
    +literature : jsonb
    +applications : jsonb  [texts as L]
    +test_cases : jsonb  [texts as L]
    +io_notes : jsonb  [texts as L]
    +process_config : jsonb  [providers.yaml fields]
    +status : text  [workflow, see REF-F12]
    +exec_state : text  [generated from status]
    +status_note : text
    +status_changed_by : text FK
    +status_changed_at : timestamptz
    +published_at : timestamptz
    +verified_by : text FK  [≠ owner_sub]
    +verified_at : timestamptz
    +verification_job_id : text
    +verified_interface : jsonb
    +verified_interface_sha256 : text
    +current_interface_sha256 : text
    +interface_state : text  [in_sync, drifted, …]
    +last_checked_at : timestamptz
    +created_at : timestamptz
    +updated_at : timestamptz
  }
  class project {
    <<table>>
    +id : uuid PK
    +owner_sub : text FK
    +name : text  UK[owner_sub, name]
    +description : text
    +created_at : timestamptz
    +updated_at : timestamptz
  }
  class project_job {
    <<table · n∶m>>
    +project_id : uuid PK, FK  [on delete cascade]
    +job_id : text PK, FK  [public.jobs.id, on delete cascade]
    +added_by : text FK
    +added_at : timestamptz
  }
  class audit_log {
    <<append-only, 3 months>>
    +id : bigint PK
    +occurred_at : timestamptz
    +actor_sub : text
    +actor_roles : text[]
    +action : text
    +model_id : uuid
    +job_id : text
    +outcome : success | denied | failure
    +details : jsonb
    +request_id : text
  }
}

namespace Existing_UMP_backend {
  class jobs {
    <<table>>
    +id : text PK
    +process_id : text  [provider∶process]
    +user_id : text  [JWT sub]
    +status : text
    +inputs : jsonb
    +further columns unchanged
  }
}

provider_server "1" <-- "*" model : runs on
app_user "1" <-- "*" model : owner_sub
app_user "0..1" <-- "*" model : verified_by
app_user "0..1" <-- "*" model : status_changed_by
app_user "0..1" <-- "*" provider_server : owner
app_user ..> KeycloakRealm : sub
app_user "1" <-- "*" project : owner_sub
project "1" <-- "*" project_job : contains
jobs "1" <-- "*" project_job : grouped in
app_user "1" <-- "*" project_job : added_by
jobs ..> model : process_id = name∶remote_process_id
jobs ..> app_user : user_id = sub
audit_log ..> model : model_id
audit_log ..> jobs : job_id
